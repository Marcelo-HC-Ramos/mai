# ===== MONGODB (docker-compose usa essas credenciais) =====
MONGO_USER=mairoot
MONGO_PASSWORD=YOUR_SECURE_MONGO_PASSWORD_HERE
# MAI_MONGO_URI será montada automaticamente pelo docker-compose
# MAI_MONGO_DB é atribuído automaticamente
MAI_MONGO_DB=mai

# ===== REDIS (docker-compose usa essa senha) =====
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE
# MAI_REDIS_URL será montada automaticamente pelo docker-compose

# ===== SEGURANÇA =====
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
MAI_SECRET_KEY=YOUR_LONG_RANDOM_SECRET_KEY_HERE_MIN_32_CHARS
MAI_SESSION_HOURS=12

# Gere com: python -m mai.cli gen-key
MAI_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# ===== AMBIENTE =====
MAI_ENVIRONMENT=production
MAI_DOMAIN=mai.ramosys.com.br
MAI_PORT=8000

# ===== MERCADO LIVRE CONNECTOR =====
# demo = dados sintéticos | mercadolivre = API oficial (requer OAuth)
MAI_CONNECTOR=demo
MAI_SEED_DEMO=1

# Aplicativo criado em https://developers.mercadolivre.com.br/devcenter
# Após conectar conta real, altere MAI_CONNECTOR para "mercadolivre"
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://mai.ramosys.com.br/auth/mercadolivre/callback
ML_SITE_ID=MLB

# ===== IA (Gemini) =====
# Opcional; crie chave em https://aistudio.google.com/apikey
# Deixe vazio para usar fallback rule-based
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=10

# ===== CONFIGURAÇÕES DE NEGÓCIO =====
MAI_MIN_MARGIN_PCT=15
MAI_STOCK_ALERT_DAYS=15
